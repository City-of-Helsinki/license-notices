{
  "name": "@city-of-helsinki/license-notices",
  "version": "0.1.0",
  "description": "Third-party license notices for the production build of a Vite or Next.js application",
  "keywords": [
    "vite-plugin",
    "nextjs",
    "webpack-plugin",
    "license",
    "third-party-notices",
    "open-source-compliance"
  ],
  "homepage": "https://github.com/City-of-Helsinki/license-notices#readme",
  "bugs": "https://github.com/City-of-Helsinki/license-notices/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/City-of-Helsinki/license-notices.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    }
  },
  "files": [
    "dist",
    "licenseTexts"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.9.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "pnpm build",
    "pack:local": "pnpm pack --out \"license-notices-local-$(date +%Y%m%d%H%M%S).tgz\"",
    "prepare": "husky"
  },
  "dependencies": {
    "rollup-license-plugin": "^3.2.1",
    "spdx-expression-parse": "^5.0.0"
  },
  "peerDependencies": {
    "next": "^16",
    "vite": "^7 || ^8",
    "webpack": "^5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/spdx-expression-parse": "^4.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "next": "^16.4.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "webpack": "^5.111.1"
  }
}
